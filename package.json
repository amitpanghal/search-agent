{
  "name": "search-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kambi intent-resolver \u2014 extractor + structural eval (Sprint 1).",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server/index.ts",
    "serve": "tsx --env-file=.env src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "eval": "tsx src/eval/run.ts",
    "test": "node --import tsx --test src/resolver/*.test.ts",
    "catalogs": "tsx scripts/build-catalogs.ts",
    "sweep": "tsx scripts/sweep-offerings.ts",
    "probe": "tsx --env-file=.env scripts/probe.ts",
    "gate:live-menu": "tsx src/eval/live-menu-gate.ts",
    "typecheck": "tsc --noEmit",
    "gold": "tsx scripts/expand-gold.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.967.0",
    "@hono/node-server": "^2.0.6",
    "hono": "^4.12.27",
    "tsx": "^4.22.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
