// Biome: the one linter and formatter (npm run lint / npm run format; the pre-commit hook runs `check --staged`).
// Style values are the ones the tree already followed when this landed (see the code-standards skill).
{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  // TypeScript only. Prompts (.md), gold decks (.jsonl), the menu snapshot and catalogs are data, never reformatted.
  "files": { "includes": ["src/**/*.ts", "scripts/*.ts"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  // Import sorting off: it would reorder imports in most files for no gain in a small tree.
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        // `arr[i]!` inside a bounds-checked loop is the idiom under noUncheckedIndexedAccess (code-standards skill).
        "noNonNullAssertion": "off",
        "noDefaultExport": "error"
      },
      "suspicious": {
        // `cached ??= load()` and `while ((m = re.exec(s)))` are deliberate; TypeScript already types the condition.
        "noAssignInExpressions": "off"
      }
    }
  }
}
