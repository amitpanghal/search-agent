{
  "family": "search-agent-dev",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": { "operatingSystemFamily": "LINUX", "cpuArchitecture": "ARM64" },
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/search-agent-dev-execution-role",
  "containerDefinitions": [
    {
      "name": "search-agent",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/search-agent:dev",
      "essential": true,
      "portMappings": [{ "containerPort": 3000, "protocol": "tcp" }],
      "environment": [
        { "name": "PORT", "value": "3000" },
        { "name": "LLM_PROVIDER", "value": "deepseek" },
        { "name": "DEEPSEEK_MODEL", "value": "deepseek-flash" },
        { "name": "DEEPSEEK_PRICE_IN", "value": "0.15" },
        { "name": "DEEPSEEK_PRICE_OUT", "value": "0.60" },
        { "name": "DEEPSEEK_PRICE_CACHED", "value": "0.003" }
      ],
      "secrets": [
        {
          "name": "DEEPSEEK_API_KEY",
          "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/search-agent/dev/DEEPSEEK_API_KEY"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/search-agent-dev",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "stopTimeout": 30
    }
  ]
}
