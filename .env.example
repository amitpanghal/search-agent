# AWS credentials for the Bedrock extractor, and the Jev key for the entity gate and the market pick (below).
# Copy this file to `.env` (gitignored), or export these in your shell. The server
# loads them via `--env-file=.env`; the eval runner reads .env via process.env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# On-demand models need the cross-region inference profile id (see bedrock-call.ts).
BEDROCK_MODEL=qwen.qwen3-next-80b-a3b

# Bedrock price for BEDROCK_MODEL, USD per 1M tokens — set these to surface per-query cost in the
# response envelope (unset => cost reports 0; token counts are always real). See the AWS Bedrock pricing page.
BEDROCK_PRICE_IN=
BEDROCK_PRICE_OUT=

# TypeSafe Jev settles the entity gate (resolve-entities.ts) and picks the market (resolve-market.ts), both via
# jev-call.ts. Key from console.typesafe.ai.
JEV_ACCESS_KEY=
JEV_MODEL=jev-latest
# Commit a pick only when its probability reaches this; below it the user is asked (default 0.8).
JEV_ENTITY_THRESHOLD=0.8
# Trust a market pick when its probability reaches this, or when Jev is at least 0.8 sure SOME market fits
# (1 - p(none), fixed in code); below both the bet is "no market" (default 0.7: the 2026-09-22 replay put right
# picks at 0.72-1.00 and confident-wrong ones at 0.62 and under).
JEV_MARKET_THRESHOLD=0.7
# USD per 1M input tokens; Jev output is free.
JEV_PRICE_IN=0.042
