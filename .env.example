# AWS credentials for the Bedrock model (extractor, entity resolver, market pick).
# Copy this file to `.env` (gitignored), or export these in your shell. The server
# loads them via `--env-file=.env`; the eval runner reads .env via process.env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# On-demand models need the cross-region inference profile id (see bedrock-call.ts).
BEDROCK_MODEL=qwen.qwen3-next-80b-a3b

# Bedrock price for BEDROCK_MODEL, USD per 1M tokens — set these to surface per-query cost in the
# response envelope (unset => cost reports 0; token counts are always real). See the AWS Bedrock pricing page.
BEDROCK_PRICE_IN=
BEDROCK_PRICE_OUT=

# Run every LLM stage on DeepSeek's own API instead of Bedrock (DeepSeek V4.1 Flash is not on Bedrock).
# Prices: USD per 1M tokens, off-peak list price (cache miss / output / cache hit; peak hours bill 2x).
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_PRICE_IN=0.15
# DEEPSEEK_PRICE_OUT=0.60
# DEEPSEEK_PRICE_CACHED=0.003
