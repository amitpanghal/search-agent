# Scratch: captured live-response envelope dump at repo root (debug output, not source).
/wc26-envelope-live.json

# Machine-local Claude Code settings/permissions.
.claude/settings.local.json

# Per-sport offering fact sheets (`npm run sweep`). Regenerate any time — they track the live feed, so a
# committed copy would be stale within days. The durable read-out is planning/offering-sweep-findings.md.
.sweep/

# Transient probe-script scratch (dot-prefixed under scripts/: scratch .ts probes + their JSON/txt/out/err dumps).
scripts/.*.ts
scripts/.*.json
scripts/.*.txt
scripts/.*.out
scripts/.*.err
scripts/.trace-out/

# Catalog: durable per-sport artifacts (catalogData/<slug>-scope-index.json + curated
# <slug>-scope-aliases.json) are TRACKED — no allowlist needed since only those files live there.
# Build intermediates (the shared groups.json tree + per-sport participant feeds) are scratch,
# regenerated by scripts/build-catalogs.ts.
.catalog-build/

# Raw per-sport participant/offering dumps + Playwright one-offs, left at the repo root by hand. Debug
# output, not source: regenerate with scripts/fetch-participants.ts. Were tracked until 2026-08-20.
/P_*.json
/pw-*.mjs
